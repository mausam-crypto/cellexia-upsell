# ── Shopify app credentials ─────────────────────────────────────────────
# Get these from the Partner Dashboard after creating the app,
# or let `shopify app config link` / `shopify app dev` fill them in.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,read_orders,read_inventory,read_locales,read_markets,write_discounts

# ── Database ─────────────────────────────────────────────────────────────
# Dev default: SQLite. For production use Postgres and switch the
# provider in prisma/schema.prisma (see docs/IMPLEMENTATION_GUIDE.md).
DATABASE_URL="file:dev.sqlite"

# ── AI copywriting (Anthropic Claude) ────────────────────────────────────
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Optional: DeepL for translations (otherwise Claude is used) ─────────
DEEPL_API_KEY=
